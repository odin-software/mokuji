# Configuración de mokuji para desarrollo local.
# Copiar a .env y ajustar lo que necesites. El archivo .env está git-ignorado.

# Servidor HTTP
HTTP_ADDR=:8080

# URL base, usada en links dentro de emails (OTP, eventualmente notificaciones)
BASE_URL=http://localhost:8080

# Cookies con flag Secure: false en dev sin HTTPS, true en producción con HTTPS
SECURE_COOKIES=false

# Cuando mokuji corre detrás de un reverse proxy (nginx, etc.) en producción,
# poner true para que rate limiting y logging usen el IP real del cliente
# via X-Forwarded-For. NO activar si mokuji se expone directamente — un
# cliente podría spoofear el IP y saltar el rate limit.
TRUST_PROXY=false

# Base de datos SQLite
DB_PATH=./data/mokuji.db

# SMTP — los defaults apuntan a Mailpit definido en compose.yaml
# UI web de Mailpit: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=mokuji <auth@mokuji.local>

# Secret para firmar tokens de unsubscribe (HMAC-SHA256). Mínimo 32 bytes.
# Generar con: openssl rand -base64 32
# En dev queda un default obvio si está vacío; en prod (SECURE_COOKIES=true)
# falla rápido si falta. Rotarlo invalida todos los links de baja pendientes.
UNSUBSCRIBE_SECRET=

# Bearer token para endpoints administrativos (ej. POST /admin/trigger-digest
# que dispara el digest semanal manualmente para QA). Vacío = endpoints
# deshabilitados (responden 401 a todo). Generar con: openssl rand -base64 32
ADMIN_TOKEN=

# Pepper para el hash del audit log de cuentas borradas (deletion_log).
# Vacío = los hashes son enumerables (un atacante con acceso a la DB podría
# saber qué user_ids fueron borrados probando 1..N). En prod (SECURE_COOKIES=true)
# falla rápido si falta. Generar con: openssl rand -base64 32
DELETION_LOG_PEPPER=

# --- Sources de release tracking (Fase 3, ADR 0014) ---
#
# MangaDex está siempre habilitado — no tiene env var.
#
# Asura Scans: agregador de scanlation con API JSON pública sin documentar.
# Default on; bajar a false para self-hosters que prefieran solo MangaDex
# (zona gris legal: Asura es scanlation no oficial). El dominio rota cada
# tantos meses — si caen los pollings, chequear https://asurascans.com y
# overridear los base URLs sin redeploy de código.
ASURA_ENABLED=true
ASURA_API_BASE_URL=
ASURA_FRONTEND_BASE_URL=

# Comick.app: descartado de v1 — su API real (comick.dev) está atrás de
# Cloudflare managed challenge y no se puede hablar con ella desde Go
# vanilla sin un sidecar headless (FlareSolverr). Queda como TODO para
# cuando relajen el bot detection o aceptemos esa dependencia.
