# Configuración de mokuji para desarrollo local.
# Copiar a .env y ajustar lo que necesites. El archivo .env está git-ignorado.

# Servidor HTTP
HTTP_ADDR=:8080

# URL base, usada en links dentro de emails (OTP, eventualmente notificaciones)
BASE_URL=http://localhost:8080

# Cookies con flag Secure: false en dev sin HTTPS, true en producción con HTTPS
SECURE_COOKIES=false

# Cuando mokuji corre detrás de un reverse proxy (nginx, etc.) en producción,
# poner true para que rate limiting y logging usen el IP real del cliente
# via X-Forwarded-For. NO activar si mokuji se expone directamente — un
# cliente podría spoofear el IP y saltar el rate limit.
TRUST_PROXY=false

# Base de datos SQLite
DB_PATH=./data/mokuji.db

# SMTP — los defaults apuntan a Mailpit definido en compose.yaml
# UI web de Mailpit: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=mokuji <auth@mokuji.local>
